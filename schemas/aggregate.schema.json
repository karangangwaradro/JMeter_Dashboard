{
  "$defs": {
    "ErrorDetail": {
      "description": "Categorized error summary with representative occurrences.",
      "properties": {
        "error_key": {
          "title": "Error Key",
          "type": "string"
        },
        "code": {
          "default": "",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "failure_message": {
          "default": "",
          "title": "Failure Message",
          "type": "string"
        },
        "count": {
          "default": 0,
          "title": "Count",
          "type": "integer"
        },
        "occurrences": {
          "items": {
            "$ref": "#/$defs/ErrorOccurrence"
          },
          "title": "Occurrences",
          "type": "array"
        }
      },
      "required": [
        "error_key"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorOccurrence": {
      "description": "Metadata for an error sample occurrence.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "timestamp": {
          "default": 0,
          "title": "Timestamp",
          "type": "integer"
        },
        "elapsed": {
          "default": 0,
          "title": "Elapsed",
          "type": "integer"
        }
      },
      "required": [
        "label"
      ],
      "title": "ErrorOccurrence",
      "type": "object"
    },
    "TransactionMetric": {
      "description": "Aggregated metrics for a single transaction / request label.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "count": {
          "default": 0,
          "description": "Total executions of this transaction",
          "title": "Count",
          "type": "integer"
        },
        "errors": {
          "default": 0,
          "description": "Number of failed executions",
          "title": "Errors",
          "type": "integer"
        },
        "error_rate": {
          "default": 0.0,
          "description": "Percentage of executions that failed (0-100)",
          "title": "Error Rate",
          "type": "number"
        },
        "avg_rt": {
          "default": 0.0,
          "description": "Mean response time in ms",
          "title": "Avg Rt",
          "type": "number"
        },
        "min_rt": {
          "default": 0.0,
          "description": "Minimum response time in ms",
          "title": "Min Rt",
          "type": "number"
        },
        "max_rt": {
          "default": 0.0,
          "description": "Maximum response time in ms",
          "title": "Max Rt",
          "type": "number"
        },
        "p50": {
          "default": 0.0,
          "description": "50th percentile (median) response time in ms",
          "title": "P50",
          "type": "number"
        },
        "p90": {
          "default": 0.0,
          "description": "90th percentile response time in ms",
          "title": "P90",
          "type": "number"
        },
        "p95": {
          "default": 0.0,
          "description": "95th percentile response time in ms",
          "title": "P95",
          "type": "number"
        },
        "p99": {
          "default": 0.0,
          "description": "99th percentile response time in ms",
          "title": "P99",
          "type": "number"
        },
        "samples": {
          "description": "Raw response time samples (optional)",
          "items": {
            "type": "integer"
          },
          "title": "Samples",
          "type": "array"
        },
        "success_flags": {
          "description": "Success boolean for samples (optional)",
          "items": {
            "type": "boolean"
          },
          "title": "Success Flags",
          "type": "array"
        }
      },
      "required": [
        "label"
      ],
      "title": "TransactionMetric",
      "type": "object"
    }
  },
  "description": "Common normalized aggregate performance result contract across all performance tools\n(JMeter, BlazeMeter, NeoLoad, etc.).",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "description": "Contract schema version",
      "title": "Schema Version",
      "type": "string"
    },
    "test_id": {
      "description": "Unique test run identifier",
      "title": "Test Id",
      "type": "string"
    },
    "tool": {
      "description": "Performance testing tool name (e.g. jmeter, blazemeter, neoload)",
      "title": "Tool",
      "type": "string"
    },
    "total_requests": {
      "default": 0,
      "description": "Total sample requests executed",
      "title": "Total Requests",
      "type": "integer"
    },
    "total_iterations": {
      "default": 1,
      "description": "Total complete journey iterations completed",
      "title": "Total Iterations",
      "type": "integer"
    },
    "successful_requests": {
      "default": 0,
      "description": "Number of successful requests",
      "title": "Successful Requests",
      "type": "integer"
    },
    "failed_requests": {
      "default": 0,
      "description": "Number of failed requests",
      "title": "Failed Requests",
      "type": "integer"
    },
    "error_rate": {
      "default": 0.0,
      "description": "Overall transaction error percentage (0-100)",
      "title": "Error Rate",
      "type": "number"
    },
    "raw_error_rate": {
      "default": 0.0,
      "description": "Raw HTTP request error percentage (0-100)",
      "title": "Raw Error Rate",
      "type": "number"
    },
    "throughput": {
      "default": 0.0,
      "description": "Overall transactions per second (TPS)",
      "title": "Throughput",
      "type": "number"
    },
    "avg_response_time": {
      "default": 0.0,
      "description": "Overall average response time in ms",
      "title": "Avg Response Time",
      "type": "number"
    },
    "min_response_time": {
      "default": 0.0,
      "description": "Overall minimum response time in ms",
      "title": "Min Response Time",
      "type": "number"
    },
    "max_response_time": {
      "default": 0.0,
      "description": "Overall maximum response time in ms",
      "title": "Max Response Time",
      "type": "number"
    },
    "p50": {
      "default": 0.0,
      "description": "50th percentile response time in ms",
      "title": "P50",
      "type": "number"
    },
    "p90": {
      "default": 0.0,
      "description": "90th percentile response time in ms",
      "title": "P90",
      "type": "number"
    },
    "p95": {
      "default": 0.0,
      "description": "95th percentile response time in ms",
      "title": "P95",
      "type": "number"
    },
    "p99": {
      "default": 0.0,
      "description": "99th percentile response time in ms",
      "title": "P99",
      "type": "number"
    },
    "duration_seconds": {
      "default": 0.0,
      "description": "Total test duration in seconds",
      "title": "Duration Seconds",
      "type": "number"
    },
    "start_epoch": {
      "default": 0,
      "description": "Unix timestamp of test start",
      "title": "Start Epoch",
      "type": "integer"
    },
    "end_epoch": {
      "default": 0,
      "description": "Unix timestamp of test end",
      "title": "End Epoch",
      "type": "integer"
    },
    "transactions": {
      "additionalProperties": {
        "$ref": "#/$defs/TransactionMetric"
      },
      "description": "Keyed by transaction label",
      "title": "Transactions",
      "type": "object"
    },
    "transactions_by_thread_group": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/TransactionMetric"
        },
        "type": "object"
      },
      "description": "Thread group -> transaction label -> metrics",
      "title": "Transactions By Thread Group",
      "type": "object"
    },
    "errors_breakdown": {
      "additionalProperties": {
        "$ref": "#/$defs/ErrorDetail"
      },
      "description": "Keyed by error diagnostic key",
      "title": "Errors Breakdown",
      "type": "object"
    }
  },
  "required": [
    "test_id",
    "tool"
  ],
  "title": "AggregateResult",
  "type": "object"
}