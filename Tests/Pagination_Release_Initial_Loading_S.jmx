        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="filename" />
          <stringProp name="parameters" />
          <stringProp name="script">import java.util.UUID
import java.util.Base64
import java.security.MessageDigest
import java.security.SecureRandom

// ==============================
// Helper: Generate PKCE pair
// ==============================
def generatePkcePair = {
    def random = new SecureRandom()
    byte[] code = new byte[32]
    random.nextBytes(code)

    def codeVerifier = Base64.getUrlEncoder().withoutPadding().encodeToString(code)

    MessageDigest md = MessageDigest.getInstance("SHA-256")
    byte[] digest = md.digest(codeVerifier.getBytes("US-ASCII"))
    def codeChallenge = Base64.getUrlEncoder().withoutPadding().encodeToString(digest)

    return [verifier: codeVerifier, challenge: codeChallenge]
}

// ==============================
// Helper: Generate state
// ==============================
def generateState = { interactionType -&gt;
    def stateId = UUID.randomUUID().toString()
    def stateJson = """{"id":"${stateId}","meta":{"interactionType":"${interactionType}"}}"""

    def encodedJson = Base64.getEncoder()
            .encodeToString(stateJson.getBytes("UTF-8"))
            .replace("=", "")

    def redirectUrl = "https://outlook.office365.com/mail/"
    def encodedUrl = Base64.getEncoder()
            .encodeToString(redirectUrl.getBytes("UTF-8"))
            .replace("=", "")

    return encodedJson + "|" + encodedUrl
}

// ==============================
// Fixed values
// ==============================
vars.put("P_Client_id_43", "9199bf20-a13f-4107-85dc-02114787ef48")

// ==============================
// General UUIDs
// ==============================
vars.put("UUID", UUID.randomUUID().toString())
vars.put("P_client-request-id_43", UUID.randomUUID().toString())

// ==============================
// Nonces
// ==============================
vars.put("P_nounce_43", UUID.randomUUID().toString())
vars.put("P_nounce_47", UUID.randomUUID().toString())

// ==============================
// States
// ==============================
// 43 = silent
vars.put("P_state_43", generateState("silent"))

// 47 = redirect
vars.put("P_state_47", generateState("redirect"))

// ==============================
// PKCE for request 43
// challenge used in authorize request 43
// verifier used later in token request for flow 43
// ==============================
//def pkce43 = generatePkcePair()
//vars.put("P_code_verifier_43", pkce43.verifier)
//vars.put("P_code_challenge_43", pkce43.challenge)

// ==============================
// PKCE for request 47 / request 112 pair
// challenge used in authorize request 47
// verifier used later in request 112
// ==============================
def pkce47 = generatePkcePair()
//vars.put("P_code_challenge_47", pkce47.challenge)
//vars.put("P_code_ver_112", pkce47.verifier)

//// Optional: only keep this if some request explicitly uses it
//vars.put("P_code_verifier_47", pkce47.verifier)

// ==============================
// Logs (for debugging)

//log.info("P_nounce_43 = " + vars.get("P_nounce_43"))
//log.info("P_state_43 = " + vars.get("P_state_43"))
//log.info("P_code_verifier_43 = " + vars.get("P_code_verifier_43"))
//log.info("P_code_challenge_43 = " + vars.get("P_code_challenge_43"))
//
//log.info("P_nounce_47 = " + vars.get("P_nounce_47"))
//log.info("P_state_47 = " + vars.get("P_state_47"))
//log.info("P_code_challenge_47 = " + vars.get("P_code_challenge_47"))
//log.info("P_code_ver_112 = " + vars.get("P_code_ver_112"))
////
////log.info("==========================================")// ==============================
//log.info("========== GENERATED AUTH VALUES ==========")
//log.info("UUID = " + vars.get("UUID"))
//log.info("P_client-request-id_43 = " + vars.get("P_client-request-id_43"))
////</stringProp>
