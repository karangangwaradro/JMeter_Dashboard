                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CT_FromEmail_1276" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">CT_FromEmail_1276</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.Body.ResponseMessages.Items[0].Conversation.ConversationNodes[0].Items[0].Sender.Mailbox.EmailAddress</stringProp>
