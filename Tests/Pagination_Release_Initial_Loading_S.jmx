              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters" />
                <stringProp name="filename" />
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def ignoreNames = ['Drafts','Sent Items','Deleted Items','Junk Email','Archive'] as Set

int total = vars.get('CT_folderName_115_matchNr') as int
def list = []

for (int i = 1; i &lt;= total; i++) {
    def name = vars.get("folderName_" + i)
    def id   = vars.get("folderId_" + i)
    if (ignoreNames.contains(name)) {
        list &lt;&lt; """{"__type":"FolderId:#Exchange","Id":"${id}"}"""
    }
}

vars.put("FoldersToIgnoreJson", "[${list.join(',')}]")</stringProp>
              </JSR223PostProcessor>
