                <hashTree />
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters" />
                  <stringProp name="filename" />
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import groovy.json.JsonBuilder

int count = (vars.get('CT_ToEmail_1276_matchNr') ?: '0') as int

def result = []
for (int i = 1; i &lt;= count; i++) {
    def email = vars.get("CT_ToEmail_1276_${i}")
    if (email) {
        result &lt;&lt; [smtpAddress: email, field: 'TO']
    }
}

// Build JSON and store in a JMeter variable
def json = new JsonBuilder(result).toPrettyString()
vars.put('toRecipientsJson', json)

// Optional: log it
log.info("Extracted TO recipients JSON: " + json)</stringProp>
                </JSR223PostProcessor>
                <hashTree />
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="parameters" />
                  <stringProp name="filename" />
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonBuilder

// Get the JSON array string created earlier, e.g. `[{"smtpAddress":"...","field":"TO"}, ...]`
def toRecipientsJson = vars.get('toRecipientsJson')

// Parse safely (handle null/empty)
def toList = []
if (toRecipientsJson &amp;&amp; toRecipientsJson.trim().startsWith('[')) {
    toList = new JsonSlurper().parseText(toRecipientsJson) as List
}

// Append FROM entry
def fromEmail = vars.get('CT_FromEmail_1276')
if (fromEmail) {
    toList &lt;&lt; [smtpAddress: fromEmail, field: 'FROM']
}

// Serialize back to JSON array
def emailRecipientsJson = new JsonBuilder(toList).toString()

// Store for later use
vars.put('EmailRecipients', emailRecipientsJson)

// Optional log
log.info("EmailRecipients: " + emailRecipientsJson)</stringProp>
                </JSR223PostProcessor>
