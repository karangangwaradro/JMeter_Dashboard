# Results directory outputs
Results/*
!Results/.gitkeep
!Results/html/
!Results/html/.gitkeep
!Results/json/
!Results/json/.gitkeep
!Results/jtl/
!Results/jtl/.gitkeep
!Results/Published/
!Results/Published/.gitkeep

# Exclude JTL files and logs completely from Git
*.jtl
Results/jtl/*.jtl
Results/*.jtl
*.log
logs/*
!logs/.gitkeep
Results/logs/*
!Results/logs/.gitkeep

# Python bytecode and virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
venv/
.venv/

# Environment configuration
config/.env

# OS & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# AI Assistant Skills & Configurations
.claude/
.gemini/
.impeccable/
.agents/
skills/

